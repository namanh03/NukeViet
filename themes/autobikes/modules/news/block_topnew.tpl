<div class="row topnews">
  <!-- Tin lớn -->
  <!-- BEGIN: mainnews -->
  <div class="col-md-12 main-news">
    <a href="{mainnews.link}">
      <img src="{mainnews.thumb}" alt="{mainnews.title}" class="img-responsive">
      <div class="news-caption">
        <h2>{mainnews.title}</h2>
        <span>{mainnews.time}</span>
      </div>
    </a>
  </div>
  <!-- END: mainnews -->

  <!-- 3 tin nhỏ -->
  <div class="col-md-12 sub-news">
    <div class="row">
      <!-- BEGIN: othernews -->
      <div class="col-md-4 col-sm-12">
        <a href="{othernews.link}">
          <img src="{othernews.thumb}" alt="{othernews.title}" class="img-responsive">
          <h4>{othernews.title}</h4>
        </a>
      </div>
      <!-- END: othernews -->
    </div>
  </div>
</div>