<div class="block-tindocnhieu">
    <!-- BEGIN: main -->
    <ul class="news-hot-list">
        <!-- BEGIN: loop -->
        <li class="news-item" style="margin-bottom:10px; list-style:none;">
            <!-- BEGIN: img -->
            <div class="news-thumb" style="float:left; margin-right:10px;">
                <a href="{ROW.link}">
                    <img src="{IMG.thumb}" alt="{ROW.title}" width="100">
                </a>
            </div>
            <!-- END: img -->
            <div class="news-title">
                <a href="{ROW.link}">{ROW.title}</a>
            </div>
            <div style="clear:both;"></div>
        </li>
        <!-- END: loop -->
    </ul>
    <!-- END: main -->
</div>
